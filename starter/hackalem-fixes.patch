+        isolated = n.gid.iloc[2]
+        self.assertEqual(f.loc[isolated, "in_deg"], 0)
+        self.assertEqual(f.loc[isolated, "out_deg"], 0)
+        self.assertGreater(f.loc[isolated, "pagerank"], 0)
+        self.assertAlmostEqual(f.pagerank.sum(), 1)
